                    y="130"
                    width="245"
                    height="35"
                    backcolor="#17A2B8"
                    mode="Opaque"/>

                <textElement textAlignment="Center">

                    <font
                        size="14"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[TOTAL PROCESSING AMOUNT]]>
                </text>

            </staticText>


            <textField
                pattern="#,##0.00">

                <reportElement
                    x="536"
                    y="165"
                    width="245"
                    height="65"
                    backcolor="#E8F7FA"
                    mode="Opaque"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font
                        size="20"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{total_processing_amount}]]>
                </textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- DASHBOARD INFORMATION                            -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="0"
                    y="250"
                    width="782"
                    height="35"
                    backcolor="#163A5F"
                    mode="Opaque"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font
                        size="16"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[CTS DAILY PROCESSING OVERVIEW]]>
                </text>

            </staticText>

        </band>

    </detail>


    <!-- ===================================================== -->
    <!-- SUMMARY                                              -->
    <!-- ===================================================== -->

    <summary>

        <band height="100">

            <staticText>

                <reportElement
                    x="0"
                    y="10"
                    width="782"
                    height="25"
                    backcolor="#F2F2F2"

                </textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- KPI 4 - MICR REPAIR PENDING                     -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="0"
                    y="130"
                    width="245"
                    height="35"
                    backcolor="#FF7F0E"
                    mode="Opaque"/>

                <textElement textAlignment="Center">

                    <font
                        size="14"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[MICR REPAIR PENDING]]>
                </text>

            </staticText>


            <textField>

                <reportElement
                    x="0"
                    y="165"
                    width="245"
                    height="65"

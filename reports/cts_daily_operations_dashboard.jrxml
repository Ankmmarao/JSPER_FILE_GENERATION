                    x="0"
                    y="10"
                    width="245"
                    height="35"
                    backcolor="#1F77B4"
                    mode="Opaque"/>

                <textElement textAlignment="Center">

                    <font
                        size="14"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[TOTAL CHEQUES]]>
                </text>

            </staticText>


            <textField>

                <reportElement
                    x="0"
                    y="45"
                    width="245"
                    height="65"
                    backcolor="#EAF3FA"
                    mode="Opaque"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font
                        size="28"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{total_cheques}]]>
                </textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- KPI 2 - APPROVED CHEQUES                         -->
            <!-- ================================================= -->

            <staticText>


                </textFieldExpression>

            </textField>


            <!-- ================================================= -->
            <!-- KPI 5 - HIGH VALUE CHEQUES                       -->
            <!-- ================================================= -->

            <staticText>

                <reportElement
                    x="268"
                    y="130"
                    width="245"
                    height="35"
                    backcolor="#9467BD"
                    mode="Opaque"/>

                <textElement textAlignment="Center">

                    <font
                        size="14"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[HIGH VALUE CHEQUES]]>
                </text>

            </staticText>


            <textField>

                <reportElement
                    x="268"
                    y="165"
                    width="245"
                    height="65"
                    backcolor="#F3ECF8"
                    mode="Opaque"/>

                <textElement textAlignment="Center"
                             verticalAlignment="Middle">

                    <font
                        size="28"
                        isBold="true"/>

                </textElement>


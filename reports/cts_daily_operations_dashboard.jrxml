<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="cts_daily_operations_dashboard"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25">

    <!-- ===================================================== -->
    <!-- PARAMETER -->
    <!-- ===================================================== -->

    <parameter
        name="P_PROCESSING_DATE"
        class="java.sql.Date"/>


    <!-- ===================================================== -->
    <!-- MAIN QUERY -->
    <!-- ===================================================== -->

    <queryString>
        <![CDATA[
            SELECT
                COUNT(*) AS total_cheques,

                COUNT(
                    CASE
                        WHEN status = 'APPROVED'
                        THEN 1
                    END
                ) AS approved_cheques,

                COUNT(
                    CASE
                        WHEN status = 'REJECTED'
                        THEN 1
                    END
                ) AS rejected_cheques,

                COUNT(
                    CASE
                        WHEN micr_status = 'INVALID'
                        THEN 1
                    END
                ) AS micr_repair_pending,

                COUNT(
                    CASE
                        WHEN cheque_amount >= 200000
                        THEN 1
                    END
                ) AS high_value_cheques,

                COALESCE(
                    SUM(cheque_amount),
                    0
                ) AS total_processing_amount

            FROM cheque_transaction

            WHERE processing_date =
                  $P{P_PROCESSING_DATE}
        ]]>
    </queryString>


    <!-- ===================================================== -->
    <!-- FIELDS -->
    <!-- ===================================================== -->

    <field
        name="total_cheques"
        class="java.lang.Long"/>

    <field
        name="approved_cheques"
        class="java.lang.Long"/>

    <field
        name="rejected_cheques"
        class="java.lang.Long"/>

    <field
        name="micr_repair_pending"
        class="java.lang.Long"/>

    <field
        name="high_value_cheques"
        class="java.lang.Long"/>

    <field
        name="total_processing_amount"
        class="java.math.BigDecimal"/>


    <!-- ===================================================== -->
    <!-- VARIABLES -->
    <!-- ===================================================== -->

    <variable
        name="V_TOTAL_CHEQUES"
        class="java.lang.Long"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{total_cheques}]]>
        </variableExpression>
    </variable>

    <variable
        name="V_APPROVED_CHEQUES"
        class="java.lang.Long"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{approved_cheques}]]>
        </variableExpression>
    </variable>

    <variable
        name="V_REJECTED_CHEQUES"
        class="java.lang.Long"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{rejected_cheques}]]>
        </variableExpression>
    </variable>

    <variable
        name="V_MICR_REPAIR_PENDING"
        class="java.lang.Long"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{micr_repair_pending}]]>
        </variableExpression>
    </variable>

    <variable
        name="V_HIGH_VALUE_CHEQUES"
        class="java.lang.Long"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{high_value_cheques}]]>
        </variableExpression>
    </variable>

    <variable
        name="V_TOTAL_PROCESSING_AMOUNT"
        class="java.math.BigDecimal"
        calculation="Nothing">
        <variableExpression>
            <![CDATA[$F{total_processing_amount}]]>
        </variableExpression>
    </variable>


    <!-- ===================================================== -->
    <!-- TITLE -->
    <!-- ===================================================== -->

    <title>

        <band height="70">

            <!-- Header background -->

            <rectangle>
                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="65"
                    backcolor="#123B63"
                    mode="Opaque"/>
            </rectangle>


            <!-- Title -->

            <staticText>

                <reportElement
                    x="20"
                    y="10"
                    width="742"
                    height="30"
                    forecolor="#FFFFFF"/>

                <textElement textAlignment="Center">

                    <font
                        size="22"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[CTS - DAILY OPERATIONS DASHBOARD]]>
                </text>

            </staticText>


            <!-- Processing Date -->

            <staticText>

                <reportElement
                    x="20"
                    y="43"
                    width="145"
                    height="18"
                    forecolor="#DCEAF7"/>

                <textElement textAlignment="Left">

                    <font
                        size="10"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Processing Date:]]>
                </text>

            </staticText>


            <textField>

                <reportElement
                    x="160"
                    y="43"
                    width="150"
                    height="18"
                    forecolor="#FFFFFF"/>

                <textElement textAlignment="Left">

                    <font
                        size="10"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        new java.text.SimpleDateFormat("dd-MMM-yyyy")
                        .format($P{P_PROCESSING_DATE})
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </title>



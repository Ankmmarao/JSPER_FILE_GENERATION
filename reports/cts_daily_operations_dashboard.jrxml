<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="cts_daily_operations_dashboard"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25">

    <!-- ===================================================== -->
    <!-- PARAMETER                                             -->
    <!-- ===================================================== -->

    <parameter
        name="P_PROCESSING_DATE"
        class="java.sql.Date"/>


    <!-- ===================================================== -->
    <!-- MAIN DASHBOARD QUERY                                  -->
    <!-- ===================================================== -->

    <queryString>
        <![CDATA[
            SELECT
                COUNT(*) AS total_cheques,

                SUM(
                    CASE
                        WHEN status = 'APPROVED'
                        THEN 1
                        ELSE 0
                    END
                ) AS approved_cheques,

                SUM(
                    CASE
                        WHEN status = 'REJECTED'
                        THEN 1
                        ELSE 0
                    END
                ) AS rejected_cheques,

                SUM(
                    CASE
                        WHEN micr_status = 'PENDING'
                        THEN 1
                        ELSE 0
                    END
                ) AS micr_repair_pending,

                SUM(
                    CASE
                        WHEN cheque_amount >= 200000
                        THEN 1
                        ELSE 0
                    END
                ) AS high_value_cheques,

                COALESCE(
                    SUM(cheque_amount),
                    0
                ) AS total_processing_amount

            FROM cheque_transaction

            WHERE processing_date = $P{P_PROCESSING_DATE}
        ]]>
    </queryString>


    <!-- ===================================================== -->
    <!-- FIELDS                                                -->
    <!-- ===================================================== -->

    <field
        name="total_cheques"
        class="java.lang.Long"/>

    <field
        name="approved_cheques"
        class="java.lang.Long"/>

    <field
        name="rejected_cheques"
        class="java.lang.Long"/>

    <field
        name="micr_repair_pending"
        class="java.lang.Long"/>

    <field
        name="high_value_cheques"
        class="java.lang.Long"/>

    <field
        name="total_processing_amount"
        class="java.math.BigDecimal"/>


    <!-- ===================================================== -->
    <!-- TITLE                                                 -->
    <!-- ===================================================== -->

    <title>

        <band height="65">

            <!-- Main title -->

            <staticText>

                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="35"
                    backcolor="#163A5F"
                    mode="Opaque"/>

                <textElement textAlignment="Center">

                    <font
                        size="22"
                        isBold="true"
                        pdfFontName="Helvetica-Bold"/>

                </textElement>

                <text>
                    <![CDATA[CTS - DAILY OPERATIONS DASHBOARD]]>
                </text>

            </staticText>


            <!-- Processing date label -->

            <staticText>

                <reportElement
                    x="0"
                    y="40"
                    width="125"
                    height="20"/>

                <textElement textAlignment="Left">

                    <font
                        size="11"
                        isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Processing Date:]]>
                </text>

            </staticText>


            <!-- Processing date value -->

            <textField
                pattern="dd-MMM-yyyy">

                <reportElement
                    x="125"
                    y="40"
                    width="150"
                    height="20"/>

                <textElement>

                    <font
                        size="11"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$P{P_PROCESSING_DATE}]]>
                </textFieldExpression>

            </textField>

        </band>

    </title>


    <!-- ===================================================== -->
    <!-- KPI AREA                                              -->
    <!-- ===================================================== -->

    <detail>

        <band height="290">


            <!-- ================================================= -->
            <!-- KPI 1 - TOTAL CHEQUES                            -->
            <!-- ================================================= -->

            <staticText>


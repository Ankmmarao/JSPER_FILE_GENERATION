<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="rejected_cheque_report"
    pageWidth="800"
    pageHeight="842"
    columnWidth="800"
    leftMargin="0"
    rightMargin="0"
    topMargin="0"
    bottomMargin="0">

    <!-- PARAMETER -->
    <parameter
        name="P_STATUS"
        class="java.lang.String"/>


    <!-- QUERY -->
    <queryString language="SQL">
        <![CDATA[
            SELECT
                cheque_number,
                customer_name,
                account_number,
                cheque_amount,
                rejection_reason
            FROM cheque_transaction
            WHERE status = 'REJECTED'
            ORDER BY cheque_id
        ]]>
    </queryString>


    <!-- FIELDS -->

    <field
        name="cheque_number"
        class="java.lang.String"/>

    <field
        name="customer_name"
        class="java.lang.String"/>

    <field
        name="account_number"
        class="java.lang.String"/>

    <field
        name="cheque_amount"
        class="java.math.BigDecimal"/>

    <field
        name="rejection_reason"
        class="java.lang.String"/>


    <!-- COLUMN HEADER -->

    <columnHeader>

        <band height="25">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="150"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Cheque No]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="150"
                    y="0"
                    width="150"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Customer]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="300"
                    y="0"
                    width="150"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Account]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="450"
                    y="0"
                    width="150"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Amount]]></text>
            </staticText>


            <staticText>
                <reportElement
                    x="600"
                    y="0"
                    width="200"
                    height="25"/>

                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Rejection Reason]]></text>
            </staticText>

        </band>

    </columnHeader>


    <!-- DETAIL -->

    <detail>

        <band height="25">


            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="150"
                    height="25"/>

                <textFieldExpression>
                    <![CDATA[$F{cheque_number}]]>
                </textFieldExpression>

            </textField>


            <textField>

                <reportElement
                    x="150"
                    y="0"
                    width="150"
                    height="25"/>

                <textFieldExpression>
                    <![CDATA[$F{customer_name}]]>
                </textFieldExpression>

            </textField>


            <textField>

                <reportElement
                    x="300"
                    y="0"
                    width="150"
                    height="25"/>

                <textFieldExpression>
                    <![CDATA[$F{account_number}]]>
                </textFieldExpression>

            </textField>


            <textField pattern="0.00">

                <reportElement
                    x="450"
                    y="0"
                    width="150"
                    height="25"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression>
                    <![CDATA[$F{cheque_amount}]]>
                </textFieldExpression>

            </textField>


            <textField isBlankWhenNull="true">

                <reportElement
                    x="600"
                    y="0"
                    width="200"
                    height="25"/>

                <textFieldExpression>
                    <![CDATA[$F{rejection_reason}]]>
                </textFieldExpression>

            </textField>


        </band>

    </detail>

</jasperReport>
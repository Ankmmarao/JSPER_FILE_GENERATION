<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="bank_summary_report"

    pageWidth="595"
    pageHeight="842"
    columnWidth="555"

    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <!-- =====================================================
         DATABASE QUERY
         One record per bank
         ===================================================== -->

    <queryString>
        <![CDATA[
            SELECT
                COALESCE(bank_name, 'Unknown') AS bank_name,
                COUNT(cheque_id) AS total_cheques,
                COALESCE(SUM(cheque_amount), 0.00) AS total_amount
            FROM cheque_transaction
            GROUP BY bank_name
            ORDER BY COALESCE(bank_name, 'Unknown')
        ]]>
    </queryString>


    <!-- =====================================================
         FIELDS
         ===================================================== -->

    <field
        name="bank_name"
        class="java.lang.String"/>

    <field
        name="total_cheques"
        class="java.lang.Long"/>

    <field
        name="total_amount"
        class="java.math.BigDecimal"/>


    <!-- =====================================================
         VARIABLES
         ===================================================== -->

    <!-- Total number of banks -->

    <variable
        name="TotalBanks"
        class="java.lang.Long"
        calculation="Count">

        <variableExpression>
            <![CDATA[
                $F{bank_name}
            ]]>
        </variableExpression>

    </variable>


    <!-- Total number of cheques -->

    <variable
        name="TotalCheques"
        class="java.lang.Long"
        calculation="Sum">

        <variableExpression>
            <![CDATA[
                $F{total_cheques} == null
                ? 0L
                : $F{total_cheques}
            ]]>
        </variableExpression>

    </variable>


    <!-- Overall cheque amount -->

    <variable
        name="OverallAmount"
        class="java.math.BigDecimal"
        calculation="Sum">

        <variableExpression>
            <![CDATA[
                $F{total_amount} == null
                ? java.math.BigDecimal.ZERO
                : $F{total_amount}
            ]]>
        </variableExpression>

    </variable>


    <!-- =====================================================
         TITLE
         ===================================================== -->

    <title>

        <band height="60">

            <staticText>

                <reportElement
                    x="0"
                    y="5"
                    width="555"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        size="18"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Bank Summary Report]]></text>

            </staticText>


            <!-- Title separator -->

            <line>

                <reportElement
                    x="0"
                    y="45"
                    width="555"
                    height="1"/>

            </line>

        </band>

    </title>


    <!-- =====================================================
         COLUMN HEADER
         ===================================================== -->

    <columnHeader>

        <band height="30">


            <!-- Bank -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#D9EAF7"

                    x="0"
                    y="0"
                    width="245"
                    height="30"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Left">

                    <font
                        size="10"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Bank]]></text>

            </staticText>


            <!-- Total Cheques -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#D9EAF7"

                    x="245"
                    y="0"
                    width="120"
                    height="30"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Center">

                    <font
                        size="10"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Total Cheques]]></text>

            </staticText>


            <!-- Total Amount -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#D9EAF7"

                    x="365"
                    y="0"
                    width="190"
                    height="30"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Right">

                    <font
                        size="10"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Total Amount]]></text>

            </staticText>

        </band>

    </columnHeader>


    <!-- =====================================================
         DETAIL
         One row per bank
         ===================================================== -->

    <detail>

        <band height="25">


            <!-- Bank -->

            <textField>

                <reportElement
                    x="0"
                    y="0"
                    width="245"
                    height="25"/>

                <box>
                    <pen lineWidth="0.3"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Left">

                    <font size="9"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{bank_name}
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- Total Cheques -->

            <textField>

                <reportElement
                    x="245"
                    y="0"
                    width="120"
                    height="25"/>

                <box>
                    <pen lineWidth="0.3"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Center">

                    <font size="9"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{total_cheques} == null
                        ? 0L
                        : $F{total_cheques}
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- Total Amount -->

            <textField
                pattern="#,##0.00">

                <reportElement
                    x="365"
                    y="0"
                    width="190"
                    height="25"/>

                <box>
                    <pen lineWidth="0.3"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Right">

                    <font size="9"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{total_amount} == null
                        ? java.math.BigDecimal.ZERO
                        : $F{total_amount}
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </detail>


    <!-- =====================================================
         SUMMARY
         ===================================================== -->

    <summary>

        <band height="135">


            <!-- Separator -->

            <line>

                <reportElement
                    x="0"
                    y="15"
                    width="555"
                    height="1"/>

            </line>


            <!-- Summary title -->

            <staticText>

                <reportElement
                    x="0"
                    y="25"
                    width="555"
                    height="25"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        size="12"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Overall Summary]]></text>

            </staticText>


            <!-- =================================================
                 TOTAL BANKS
                 ================================================= -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#F2F2F2"

                    x="0"
                    y="55"
                    width="200"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Left">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Total Banks]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="200"
                    y="55"
                    width="100"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Right">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $V{TotalBanks}
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- =================================================
                 TOTAL CHEQUES
                 ================================================= -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#F2F2F2"

                    x="0"
                    y="80"
                    width="200"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Left">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Total Cheques]]></text>

            </staticText>


            <textField>

                <reportElement
                    x="200"
                    y="80"
                    width="100"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Right">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $V{TotalCheques}
                    ]]>
                </textFieldExpression>

            </textField>


            <!-- =================================================
                 OVERALL AMOUNT
                 ================================================= -->

            <staticText>

                <reportElement
                    mode="Opaque"
                    backcolor="#F2F2F2"

                    x="0"
                    y="105"
                    width="200"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Left">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <text><![CDATA[Overall Amount]]></text>

            </staticText>


            <textField
                pattern="#,##0.00">

                <reportElement
                    x="200"
                    y="105"
                    width="100"
                    height="25"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    verticalAlignment="Middle"
                    textAlignment="Right">

                    <font
                        size="9"
                        isBold="true"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $V{OverallAmount}
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </summary>

</jasperReport>